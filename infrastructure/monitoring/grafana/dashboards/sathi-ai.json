      "targets": [
        {
          "expr": "sum(rate(sathi_llm_calls_total{outcome!~\"ok|success\"}[15m])) / clamp_min(sum(rate(sathi_llm_calls_total[15m])), 1e-9)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
