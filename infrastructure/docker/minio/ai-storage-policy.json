{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::sathi-documents"]
    },
    {
      "Sid": "ReadUploadsAndLessons",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::sathi-documents/uploads/*",
        "arn:aws:s3:::sathi-documents/lessons/*"
      ]
    },
    {
      "Sid": "ReadWriteParsed",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::sathi-documents/parsed/*"]
    }
  ]
}
