# =============================================================================
# Sathi environment template (contracts.md §2). Copy to `.env` and fill in:
#
#   ./scripts/generate-secrets.sh        (bash)     or
#   .\scripts\generate-secrets.ps1       (PowerShell)
#
# generate-secrets copies this file to .env and replaces every `__GENERATE*__`
# placeholder with a fresh random value (and an RSA key pair). NEVER commit `.env`.
#
# Upgrading an existing .env (keeps every value you already have, appends only
# the variables that are missing, e.g. after a release adds new ones):
#
#   ./scripts/generate-secrets.sh --add-missing      .\scripts\generate-secrets.ps1 -AddMissing
# In production these values come from a secret store (e.g. Azure Key Vault),
# not from a file.
# =============================================================================

# ---- Environment -------------------------------------------------------------
# development | test | staging | production. The Compose override/test/prod files
# set this explicitly per service; this value applies to the base file alone.
SATHI_ENV=development
# Reported as the `version` field on every log line and as service.version in traces.
SATHI_VERSION=0.1.0
# Public URL users open; used in verification / reset e-mail links.
APP_BASE_URL=http://localhost:8080

# ---- Database (PostgreSQL + pgvector) ------------------------------------------
# Superuser — used only by the init script and backups, never by the apps.
POSTGRES_PASSWORD=__GENERATE__
# Role sathi_app (schema app) — api, jobs, migrator-app
APP_DB_PASSWORD=__GENERATE__
# Role sathi_ai (schema ai) — ai-service, ai-ingest, migrator-ai
AI_DB_PASSWORD=__GENERATE__
# Role sathi_hangfire (schema hangfire) — jobs
HANGFIRE_DB_PASSWORD=__GENERATE__

# ---- Object storage (MinIO locally; S3/Azure Blob in production) --------------
# Root account: used ONLY by the minio server and the one-shot minio-init
# container (operators: console, backups). No application gets these values.
MINIO_ROOT_USER=sathi-minio
MINIO_ROOT_PASSWORD=__GENERATE__
# Per-service users created by minio-init (contracts §11.8, ADR 0016).
# api/jobs: read/write uploads/* and lessons/*, delete parsed/*.
STORAGE_APP_ACCESS_KEY=sathi-app
STORAGE_APP_SECRET_KEY=__GENERATE__
# ai-service/ai-ingest: read uploads/* and lessons/*, read/write parsed/*.
STORAGE_AI_ACCESS_KEY=sathi-ai
STORAGE_AI_SECRET_KEY=__GENERATE__

# ---- Internal trust & logging --------------------------------------------------
# RS256 service token api/jobs -> ai-service (contracts §11.7, ADR 0015).
# api/jobs sign with the private key; ai-service/ai-ingest verify with the public
# key only (compose passes SERVICE_TOKEN_PUBLIC_KEYS=<kid>:<public key>).
# Both values are base64 of a PEM file (private: PKCS#8, public: SPKI), one line.
# generate-secrets creates a 2048-bit pair; generate both together, never one alone.
SERVICE_TOKEN_KEY_ID=k1
SERVICE_TOKEN_PRIVATE_KEY_PEM_B64=__GENERATE_RSA_PRIVATE_PEM_B64__
SERVICE_TOKEN_PUBLIC_KEY_PEM_B64=__GENERATE_RSA_PUBLIC_PEM_B64__
# HMAC key for user_id_hash in logs. Changing it breaks log correlation per user.
LOG_HASH_SALT=__GENERATE__

# ---- Telemetry -----------------------------------------------------------------
# EMPTY = OpenTelemetry export disabled (logs still go to stdout as JSON).
# The observability profile sets it for you:  scripts/up-observability.(sh|ps1)
# To set it permanently:  OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
# Percentage of non-error, non-slow traces kept by the collector (errors and
# traces slower than 2 s are always kept). Dev 100, production rehearsal 20.
TRACE_SAMPLE_PERCENT=100
# Grafana (observability profile). Anonymous admin is enabled only by compose.override.yaml.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATE__
# Base URL the API uses to build "open in Grafana" links for admins (J8).
GRAFANA_PUBLIC_URL=http://localhost:3000

# ---- LLM (Anthropic Claude) ----------------------------------------------------
# Leave ANTHROPIC_API_KEY EMPTY to run in FAKE LLM MODE: a deterministic FakeProvider
# answers every request, nothing leaves your machine and nothing is billed.
# To use real Claude: set the key AND set LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# anthropic | fake   (the AI service falls back to fake when no key is set)
LLM_PROVIDER=fake
LLM_MODEL=claude-opus-5-5
LLM_FALLBACK_MODEL=claude-sonnet-5-5
# Global daily LLM spend cap in USD; when reached calls fail with SPEND_CAP_REACHED.
LLM_DAILY_SPEND_CAP_USD=5
# true -> every LLM call fails fast with LLM_DISABLED (emergency stop).
AI_KILL_SWITCH=false

# ---- Embeddings ----------------------------------------------------------------
# fastembed (local CPU model, no data egress, downloaded once) | fake (tests)
EMBEDDING_PROVIDER=fastembed
# 384 dimensions; changing the model requires a re-embedding job (ADR 0004).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Web search (tutor "Search the web" toggle) ---------------------------------
# tavily | brave | fake | none   (none = toggle returns WEB_SEARCH_FAILED warning)
SEARCH_PROVIDER=none
TAVILY_API_KEY=
BRAVE_API_KEY=
WEB_SEARCH_DAILY_SPEND_CAP_USD=1

# ---- AI service runtime ----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR — also changeable at runtime (PUT /internal/v1/admin/log-level)
LOG_LEVEL=INFO

# ---- E-mail (Mailpit locally; a real SMTP relay in production) -------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Sathi <no-reply@sathi.local>"

# ---- Privacy: under-18 learners (contracts §11.4, ADR 0014) ----------------------
# Registration below PRIVACY_MINIMUM_AGE is refused (AUTH_TOO_YOUNG). Below
# PRIVACY_AGE_OF_MAJORITY a guardian e-mail is required and sign-in waits for
# verifiable guardian consent (DPDP Act 2023 s.9: a child is anyone under 18 -
# do not lower it for India). PRIVACY_CONSENT_POLICY_VERSION is stored with every
# consent record; change it whenever the privacy notice / consent text changes.
PRIVACY_MINIMUM_AGE=8
PRIVACY_AGE_OF_MAJORITY=18
PRIVACY_CONSENT_POLICY_VERSION=2026-10-22

# ---- Tutor (contracts §11.5, ADR 0017) ---------------------------------------------
# An assistant message still `streaming` this many minutes after creation is
# marked failed with STREAM_INTERRUPTED (on read and by RecoverStaleStreamsJob).
TUTOR_STALE_STREAM_MINUTES=3

# ---- Seed data (migrator-app) ----------------------------------------------------
# Admin account created/updated on every migrator run.
SEED_ADMIN_EMAIL=admin@sathi.local
SEED_ADMIN_PASSWORD=__GENERATE_PASSWORD__
# Creates demo@sathi.local / Demo!12345 (Student) and instructor@sathi.local / Teach!12345
# (Instructor). Forced to true by compose.override.yaml (dev) and compose.test.yaml,
# forced to false by compose.prod.yaml.
SEED_DEMO_USERS=false

# ---- Optional infrastructure overrides (defaults shown) ---------------------------
# Host port for http://localhost:8080
WEB_PORT=8080
# Image naming for `docker compose build` (CI pushes ${SATHI_IMAGE_PREFIX}/<service>:${SATHI_IMAGE_TAG}).
SATHI_IMAGE_PREFIX=sathi
SATHI_IMAGE_TAG=local
# Quotas / tuning mapped onto the .NET keys (Quotas__*, Grading__*, Observability__*).
QUOTA_CHAT_MESSAGES_PER_DAY=200
QUOTA_WEB_SEARCHES_PER_DAY=20
QUOTA_UPLOADS_PER_DAY=20
GRADING_AUTO_ACCEPT_CONFIDENCE=0.75
SLOW_QUERY_MS=500
PG_LOG_MIN_DURATION_MS=500
# Retention for the local observability stack (production rehearsal uses longer values).
LOKI_RETENTION_PERIOD=168h
TEMPO_RETENTION=72h
PROMETHEUS_RETENTION=15d
